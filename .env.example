# ==============================================================================
# InFind - Master Environment Configuration
# ==============================================================================

# Application Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:4000
PORT=3000
WS_PORT=4000

# Database (PostgreSQL via Prisma)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infind?schema=public"

# Session Security
# Generate a high-entropy 64-character secret with: openssl rand -hex 32
SESSION_SECRET="e93b1d3187c3a05511b84f3e69a08e6c98124803db02ce852b724491979b09fa"
COOKIE_SECURE="false" # Set to "true" in production (HTTPS)

# Redis Matchmaking & State Coordination (Optional)
# If left empty, InFind automatically falls back to an atomic in-memory queue store.
REDIS_URL=""

# WebRTC STUN & TURN Infrastructure
# Default public Google STUN servers for NAT discovery:
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# TURN Relay Configuration (Required in production for symmetric NAT / strict firewalls)
# Example Coturn or Twilio/Xirsys credentials:
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Initial Admin Setup Secret (Used for seeding the initial superadmin account safely)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="InFindSecureAdmin2026!"
ADMIN_SECRET_KEY="super_secret_infind_admin_key_2026"
